# Secrets and AWS configuration (values are still provided via environment variables)
Auth__JwtSigningKey=replace-with-strong-key

# AWS credentials (API service uses the standard AWS SDK credentials chain)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=optional-session-token
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
